# VCS
.git
**/.git

# Dependencies + build output — rebuilt inside the image
node_modules
**/node_modules
dist
**/dist
coverage
**/coverage
.yarn/cache
**/.yarn/cache
.yarn/install-state.gz

# Runtime data — must never be baked into the image
data
mushpi-data
data-test
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Secrets
.env
.env.prod
.env.local
**/.env
**/.env.prod
**/.env.local

# Build tooling not needed in the context
Dockerfile
docker-compose.yml
docker-compose*.yml
.dockerignore
README.md

# Sub-repos that are never build inputs (keep the context lean).
# NOTE: mushpi-server and mushpi-client are the build inputs — the Dockerfile
# COPYs from both — and must NEVER be listed in this file.
# mushpi-grow / mushpi-mock DO land in this root — checked out on v* tag builds
# (the verify-release.sh parity check) and by the local verify recipe — but they
# are never COPY sources, so they stay listed. mushpi-docs is absent on purpose:
# nothing materializes it here.
mushpi-grow
mushpi-mock

# IDE / hooks
.vscode
.idea
.husky
