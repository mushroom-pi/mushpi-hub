# mushpi-demo-reset.service — return the demo stack to a fresh, populated state.
#
# Type=oneshot: the reset is a single pass (guard, restart, wait for healthy,
# verify, record), not a supervisor. Its exit code IS the verdict — a failed
# guard, a health-wait timeout or a failed verification exits non-zero, which is
# what `systemctl status mushpi-demo-reset.service` and the timer's LastResult
# show the next morning. Nothing here is flag-gated: the reset is a restart of a
# stack whose own clean start makes it idempotent, so running it twice is the
# same as running it once.
#
# INSTALL-TIME PLACEHOLDER PATHS — /opt/mushpi-ops is where this repo is expected
# to live on the demo host, and that is a PLACEHOLDER, not a fact about every
# machine. If the checkout sits elsewhere, change WorkingDirectory, ExecStart and
# the EnvironmentFile path together, then `systemctl daemon-reload`. The scripts
# resolve their own repo root from their location, but systemd can only find the
# unit file's absolute paths if they match reality.
#
# Install: place this file and mushpi-demo-reset.timer in /etc/systemd/system,
# then `systemctl daemon-reload && systemctl enable --now
# mushpi-demo-reset.timer`. Enabling the TIMER is the whole setup — this service
# carries no [Install] section on purpose, because enabling it directly would put
# a nightly wipe-and-reseed on the boot path.
#
# Docker dependency: Requires= makes the reset fail loudly if the daemon is not
# running instead of silently no-op'ing, and After= orders this unit behind the
# daemon's own start. Neither is a promise that the demo stack exists — `docker
# compose restart` fails non-zero when its containers do not, and demo-reset.sh
# reports that as a failure, which is the correct outcome.
[Unit]
Description=Mushroom Pi demo reset — bring the demo stack back to a fresh, populated state
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mushpi-ops
# Leading "-" makes the file optional: a host with no .env still runs, matching
# demo-reset.sh's own optional-.env handling. It is also the ONLY env supply this
# service gets — there is no env_file: in the demo compose profile, and compose
# reads the same file from WorkingDirectory for its own interpolation.
EnvironmentFile=-/opt/mushpi-ops/.env
ExecStart=/opt/mushpi-ops/scripts/demo-reset.sh
# systemd's default start timeout is 90s, which would kill this run in the middle
# of verification every single night: demo-reset.sh may legitimately spend 240s
# waiting for the server to report healthy (the image healthcheck probes at 30s
# intervals), then 30s on the seed window, then 150s on the announce/poll
# deadline — 420s of worst case before any container-stop grace is counted. 900s
# leaves roughly double headroom over that, and a run that needs all of it is a
# run that should be reported as failed rather than silently truncated.
TimeoutStartSec=900
