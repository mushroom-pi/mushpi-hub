# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# --- Required in production ---
# Shared secret the Pico units send in the X-Pico-Secret header on announce.
# Must match the value baked into each Pico's config.json.
PICO_ANNOUNCE_SECRET=change-me-to-a-random-string

# --- Data directory ---
# Absolute or relative path on the HOST where persistent data lives.
# Defaults to ./mushpi-data next to this compose file. The container's
# entrypoint creates the directory if missing and ensures it is owned by
# UID/GID 1000 (the `node` user the server runs as) — no manual preparation
# is needed for a first run. The default `pi` user matching UID/GID 1000 is
# the Raspberry Pi OS case: the hub runs on any Docker-capable single-board
# computer, so check your own UID/GID on another board. Only exotic
# filesystems (e.g. NFS with root_squash, which refuses the in-container
# chown) require pre-creating the directory with that ownership.
# MUSHPI_DATA_DIR=/home/pi/mushpi-data

# --- Image tag (optional) ---
# Override the pulled image tag for dev/pre-release builds.
# MUSHPI_IMAGE_TAG=latest

# --- Optional overrides ---
# Whether the browser-facing deployment is actually served over HTTPS (TLS
# terminated upstream or directly). Keep false for plain-HTTP LAN deployments;
# set true only when the dashboard is genuinely reached via https. Controls
# whether the server sends HSTS and the CSP `upgrade-insecure-requests`
# directive — it does NOT configure TLS itself.
# APP_HTTPS_ENABLED=false

# --- Rate limiting (opt-in) ---
# Recommended values for a LAN/Tailscale self-hosted deployment:
# MAX_REQUESTS=300
# MAX_REQUESTS_TIME=60000
# Both must be set together as positive integers — setting only one is a
# configuration error and the server refuses to start. If the pair is absent
# (or commented out), the server applies no throttling and emits no
# X-RateLimit-* response headers. /health is always exempt.
# NOTE: the tracker is per client IP, in-memory, and per container instance.
# If you run behind a reverse proxy, all clients appear to come from the
# proxy's IP and share one bucket; the server does not support trust-proxy.

# Swagger docs — leave DOCS_ENDPOINT unset to disable in production.
# DOCS_ENDPOINT=contract
# DOCS_USERNAME=mushpi
# DOCS_PASSWORD=changeMe123

# ============================================================================
# DEMO STACK (docker-compose.demo.yml) — one command, everything together:
#   scripts/demo-stack.sh
#
# Runs the hub image in the server's PUBLIC-DEMO profile (NODE_ENV=demo — the
# dashboard is read-only: every write is refused with 403 except Pico
# announce) plus five simulated Pico units built from mushpi-mock. The demo
# is entirely additive: docker-compose.yml and MUSHPI_DATA_DIR below are not
# consulted by it, and nothing here affects a hub deployment.
#
# Everything in this section is OPTIONAL — docker-compose.demo.yml carries
# defaults for every value (shown commented at each default). Uncomment only
# to override. The one REQUIRED thing for a demo boot is PICO_ANNOUNCE_SECRET:
# take it from the top of this file, or export it in the environment instead
# (hosted deployments — scripts/demo-stack.sh then runs with no .env at all).
# The demo profile refuses the published dev default `mushpi-dev-secret`, and
# scripts/demo-stack.sh checks before starting.
#
# --- Image tags (compose interpolation only, never passed into a container) ---
# MUSHPI_IMAGE_TAG is shared with the hub compose; MUSHPI_MOCK_IMAGE_TAG is
# the simulated-units image. Both default to latest. Stale-local-tag caveat
# (same as REFERENCE.md's hub note): `up` uses a locally present tag without
# rebuilding — pull explicitly or use a fresh tag to pick up new builds.
# MUSHPI_IMAGE_TAG=latest
# MUSHPI_MOCK_IMAGE_TAG=latest

# --- Demo binding (loopback by default; nothing reaches the LAN as packaged) ---
# MUSHPI_DEMO_HOST is the interface the port is published on (set 0.0.0.0 to
# expose on your LAN deliberately); MUSHPI_DEMO_PORT is the host port the
# dashboard/API answers on.
# MUSHPI_DEMO_HOST=127.0.0.1
# MUSHPI_DEMO_PORT=3000

# --- Local demo build (no CI, no registry) ---
# scripts/demo-stack-local.sh builds BOTH demo images on this machine from your
# own working copies — uncommitted changes included — rather than pulling from
# GHCR. Required layout: this repo sits BESIDE the sub-repos it builds from,
# because the build context is the directory holding mushpi-ops —
#   <parent>/mushpi-ops · <parent>/mushpi-server · <parent>/mushpi-client ·
#   <parent>/mushpi-mock
# The wrapper refuses a missing sibling up front. The images get local-only tags
# (mushpi:demo-local, mushpi-mock:demo-local) and are never pushed or pulled;
# `up` does not rebuild a tag that already exists locally, so pass --build to
# pick up edits. Everything else in this file is unchanged by the local build.
# Port overrides for the local stack: 3000 is the hub's own port too, so a local
# demo collides with whatever else is listening there (a hub container, another
# checkout's demo, a `yarn start`). Set MUSHPI_DEMO_PORT to move the host side —
# it applies in both modes, and the container side stays 3000.
# MUSHPI_DEMO_PORT=3000

# --- Demo data directory (compose interpolation only) ---
# The demo's disposable state (SQLite + images + logs), bind-mounted at /data
# into BOTH containers: the server owns it and seeds the demo's reading history
# into /data/app.sqlite on boot (insert-only, idempotent per unit — it never
# deletes). Wipe the demo = `down` then delete this directory. It is never the
# hub's MUSHPI_DATA_DIR.
# MUSHPI_DEMO_DATA_DIR=./mushpi-demo-data

# --- Server-side demo seeding ---
# Days of backdated 60-second-spaced readings the server generates per live
# demo unit (passed to the hub as SEED_READINGS_DAYS). Minimum 1; 0 and
# fractional values are boot validation errors. The demo default is 15; set
# this only to retune the depth.
# SEED_READINGS_DAYS=15
#
# Seeding is ON by default for the demo profile and off elsewhere, and the hub
# hard-refuses it under prod — so there is no reason to set SEED_ENABLED except
# to opt OUT of the demo's seeded history. Leave it unset unless you want:
# SEED_ENABLED=false

# --- Browser-facing flags ---
# CLIENT_URL is the CORS origin the server allows. The demo dashboard is served
# same-origin, so this only matters when you front it from another origin; the
# compose default tracks the demo's own port binding dynamically
# (http://localhost:<MUSHPI_DEMO_PORT>), so set it only to deviate from that.
# APP_HTTPS_ENABLED works exactly as in the hub section above (false for plain
# HTTP; true would break the UI over plaintext).
# CLIENT_URL=http://localhost:3000
# APP_HTTPS_ENABLED=false

# --- Public-demo limiters (required by NODE_ENV=demo; NOT the hub's pair) ---
# A NODE_ENV=demo boot REQUIRES all six values (three all-or-nothing pairs) —
# the server refuses to start without them, and the product hard-codes none;
# the defaults shown are compose's. Windows are MILLISECONDS. The self-hosted
# MAX_REQUESTS pair above is ignored on a demo boot. Per-visitor buckets key
# on the client IP (X-Forwarded-For is trusted only behind exactly one fronting
# proxy); on a plain laptop run every visitor shares one bucket.
# VISITOR_MAX_REQUESTS=300
# VISITOR_MAX_REQUESTS_TIME=60000
# ABUSE_MAX_REQUESTS=30
# ABUSE_MAX_REQUESTS_TIME=60000
# GLOBAL_MAX_REQUESTS=3000
# GLOBAL_MAX_REQUESTS_TIME=60000
